APP_NAME=SuperBizAgent Python
APP_ENV=local
HOST=0.0.0.0
PORT=9900

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/super_biz_agent

PROMPT_DIR=prompts
PROMPT_VERSION=ops-agent-system-v3
TOOL_SCHEMA_VERSION=ops-tools-v3

# Long-term memory backend: 'memory' (process-local) or 'postgres' (persistent).
# PostgreSQL requires `alembic upgrade head` to be run before the Harness starts.
# An invalid backend or postgres+disabled combination fails at startup.
MEMORY_ENABLED=true
MEMORY_STORE_BACKEND=memory
MEMORY_EMBEDDING_PROVIDER=local-deterministic
MEMORY_EMBEDDING_MODEL=local-deterministic
MEMORY_EMBEDDING_VERSION=phase4-local
MEMORY_EMBEDDING_DIMENSION=64
MEMORY_EMBEDDING_BATCH_SIZE=10
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_TIMEOUT_MS=30000

MODEL_PROVIDER=stub
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=qwen-plus
MODEL_TIMEOUT_MS=180000
MODEL_MAX_RETRIES=1

TENANT_DEFAULT=default-tenant
USER_DEFAULT=default-user
AGENT_DEFAULT=ops-agent

AUTH_MODE=dev_headers
AUTH_DEV_HEADERS_ENABLED=true
AUTH_TRUSTED_GATEWAY_SECRET=
AUTH_PERMISSION_ENFORCEMENT=true
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_SECRET=
AUTH_JWT_JWKS_URL=

MILVUS_ENABLED=false
MILVUS_HOST=localhost
MILVUS_PORT=19530

RAG_ENABLED=false
RAG_FIXTURE_MODE=true
RAG_MILVUS_URI=http://localhost:19530
RAG_MILVUS_TOKEN=
RAG_MILVUS_COLLECTION=superbiz_rag_chunks
RAG_EMBEDDING_PROVIDER=dashscope-openai-compatible
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_VERSION=
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_CHUNK_SIZE_TOKENS=1024
RAG_CHUNK_OVERLAP_TOKENS=100
RAG_INGESTION_STALE_AFTER_SECONDS=900
